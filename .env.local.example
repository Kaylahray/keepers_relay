# Crowns, Pudge testnet (Crown Rally). Copy to .env.local, then fill the two server values below.
# Everything NEXT_PUBLIC_ is public: it is built into the browser bundle.

NEXT_PUBLIC_CKB_NETWORK=testnet
NEXT_PUBLIC_CKB_RPC_URL=https://testnet.ckbapp.dev
NEXT_PUBLIC_CKB_JS_VM_CODE_HASH=0x3e9b6bead927bef62fcb56f0c79f4fbd1b739f32dd222beac10d346f2918bed7
NEXT_PUBLIC_CKB_JS_VM_HASH_TYPE=type
NEXT_PUBLIC_CKB_JS_VM_TX_HASH=0x756fdaf0d1ba1d2e03dc13c71c967b24021bc054893a766ccee6879c468892d2
NEXT_PUBLIC_CKB_JS_VM_INDEX=0x0
NEXT_PUBLIC_CKB_JS_VM_DEP_TYPE=code
NEXT_PUBLIC_USERNAME_TYPE_CODE_HASH=0x3e9b6bead927bef62fcb56f0c79f4fbd1b739f32dd222beac10d346f2918bed7
NEXT_PUBLIC_USERNAME_TYPE_HASH_TYPE=type
NEXT_PUBLIC_USERNAME_TYPE_ARGS=0x00001de16f41679b27664325993128e00f0b727390ff59bda5a7595080c5b650e09c01
NEXT_PUBLIC_USERNAME_BYTECODE_TX_HASH=0x873cc11a24dff79b88dc38e3e6910acff6ec749c3ccfbd8b04e9c5814ab67756
NEXT_PUBLIC_USERNAME_BYTECODE_INDEX=0x0
NEXT_PUBLIC_USERNAME_BYTECODE_DEP_TYPE=code
NEXT_PUBLIC_PROFILE_TYPE_CODE_HASH=0x3e9b6bead927bef62fcb56f0c79f4fbd1b739f32dd222beac10d346f2918bed7
NEXT_PUBLIC_PROFILE_TYPE_HASH_TYPE=type
NEXT_PUBLIC_PROFILE_TYPE_ARGS=0x0000cd3c5e49b241f16cfa6001e0f88918549d76f6160c529292128f91422b102e6201
NEXT_PUBLIC_PROFILE_BYTECODE_TX_HASH=0xa1c95beaa1b8253071e822c5045cf3f60b3fa0b7465db6d973153d73c43e9faa
NEXT_PUBLIC_PROFILE_BYTECODE_INDEX=0x0
NEXT_PUBLIC_PROFILE_BYTECODE_DEP_TYPE=code
# Crown Rally: run scripts/crowns-testnet/env-from-migration.ts after the deploy for these.
NEXT_PUBLIC_SD_LIVE_CODE_HASH=
NEXT_PUBLIC_SD_LIVE_HASH_TYPE=type
NEXT_PUBLIC_SD_LIVE_ARGS=0x
NEXT_PUBLIC_SD_LIVE_TX_HASH=
NEXT_PUBLIC_SD_LIVE_INDEX=0x0
NEXT_PUBLIC_SD_LIVE_DEP_TYPE=code
NEXT_PUBLIC_SD_RALLY_CODE_HASH=
NEXT_PUBLIC_SD_RALLY_TX_HASH=
NEXT_PUBLIC_SD_RALLY_INDEX=0x0
NEXT_PUBLIC_SD_PROXY_TX_HASH=0xa5ef4970ba0a4446b9cd8abb3b650cdfb68bcdf5052966e41384900a8a5ad274
NEXT_PUBLIC_SD_PROXY_INDEX=0x0
# The relay: its lock hash from `pnpm relay --whoami`, and the address it is hosted at.
NEXT_PUBLIC_RALLY_RELAY_LOCK_HASH=
NEXT_PUBLIC_RALLY_RELAY_URL=

# Server only. Never prefix these with NEXT_PUBLIC_.
# Neon Postgres, pooled connection string. Needed for lobbies and the players list.
DATABASE_URL=
# Any long random string. Signs the sign-in cookies.
AUTH_SECRET=
# Only where the relay runs: the private key it signs finishes with. Never in Vercel.
RALLY_RELAY_KEY=
